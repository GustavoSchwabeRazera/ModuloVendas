# Chave mantida somente no Render. Nunca a exponha no Lovable.
GEMINI_API_KEY=
# Origens públicas autorizadas a chamar a API de Vendas.
EXPORTAI_CORS_ORIGINS=https://exportai-modulo-basico.lovable.app,https://exportai-modulo-diagnostico.lovable.app,https://exportai-modulo-vendas.lovable.app
EXPORTAI_GEMINI_MODEL=gemini-3.5-flash-lite
# Desative para reduzir consumo de quota e evitar instabilidade da busca web.
EXPORTAI_PESQUISA_WEB_ATIVA=false
# Uma busca em lote valida a aderência produto/empresa dos leads do Hunter.
EXPORTAI_VALIDACAO_LEADS_ATIVA=true
# Consulta os arquivos locais em data/. Desative apenas para diagnosticar a API.
EXPORTAI_DADOS_TARIFARIOS_ATIVOS=true
# Hunter é opcional; para ativar, configure a chave no Render.
HUNTER_API_KEY=
EXPORTAI_HUNTER_ATIVO=true

